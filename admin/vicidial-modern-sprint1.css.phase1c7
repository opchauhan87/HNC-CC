/* ============================================================
   VICIdial Modern Theme - Sprint 1
   Page Shell
   ============================================================ */

#cl-wrapper.vicidial-modern-enabled {
    background: #0a0e1a !important;
    min-height: 100vh;
}

#cl-wrapper.vicidial-modern-enabled body {
    background: #0a0e1a;
}

#cl-wrapper.vicidial-modern-enabled .cl-sidebar {
    background: #0a0e1a;
    border-right: 1px solid rgba(255,255,255,0.06);
}

#cl-wrapper.vicidial-modern-enabled .cl-sidebar .menu-space,
#cl-wrapper.vicidial-modern-enabled .cl-sidebar .content {
    background: transparent;
}

#cl-wrapper.vicidial-modern-enabled #pcont {
    background: #0a0e1a;
}

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation li a {
    color: rgba(255,255,255,0.65);
}

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation li a:hover {
    color: #ffffff;
    background: rgba(255,255,255,0.05);
}

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation li.active > a {
    color: #ffffff;
    background: rgba(72,49,212,0.15);
}

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation li a i {
    color: rgba(255,255,255,0.45);
}

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation li.active > a i,
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation li a:hover i {
    color: #00c8ff;
}

#cl-wrapper.vicidial-modern-enabled .sub-menu {
    background: rgba(255,255,255,0.02);
}

#cl-wrapper.vicidial-modern-enabled .sub-menu li a {
    color: rgba(255,255,255,0.55);
}

#cl-wrapper.vicidial-modern-enabled .sub-menu li a:hover {
    color: #ffffff;
    background: rgba(255,255,255,0.04);
}

/* Main content */
#cl-wrapper.vicidial-modern-enabled #pcont {
    color: #ffffff;
}

/* Remove old bright borders/backgrounds */
#cl-wrapper.vicidial-modern-enabled .border {
    border-color: rgba(255,255,255,0.06) !important;
}

/* Modern scrollbar */
#cl-wrapper.vicidial-modern-enabled ::-webkit-scrollbar {
    width: 5px;
    height: 5px;
}

#cl-wrapper.vicidial-modern-enabled ::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.12);
    border-radius: 10px;
}

/* ============================================================
   VICIdial Modern Theme - Sprint 1
   Phase 1C.2 - LEFT SIDEBAR
   ============================================================ */

/* Sidebar */
#cl-wrapper.vicidial-modern-enabled .cl-sidebar {
    width: 260px !important;
    top: 0 !important;
    bottom: 0 !important;
    height: 100vh !important;
    background:
        radial-gradient(circle at 20% 10%, rgba(72,49,212,0.12), transparent 35%),
        #0a0e1a !important;
    border-right: 1px solid rgba(255,255,255,0.07) !important;
    box-shadow: 8px 0 30px rgba(0,0,0,0.25);
    z-index: 1000;
}

/* Sidebar inner area */
#cl-wrapper.vicidial-modern-enabled .cl-sidebar .cl-navblock,
#cl-wrapper.vicidial-modern-enabled .cl-sidebar .menu-space,
#cl-wrapper.vicidial-modern-enabled .cl-sidebar .content {
    background: transparent !important;
}

/* Existing logo area */
#cl-wrapper.vicidial-modern-enabled .sidebar-logo {
    height: 76px;
    padding: 15px 20px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background: rgba(255,255,255,0.015);
}

#cl-wrapper.vicidial-modern-enabled .sidebar-logo .logo {
    display: flex;
    align-items: center;
}

#cl-wrapper.vicidial-modern-enabled .sidebar-logo img {
    max-width: 150px;
    max-height: 44px;
    object-fit: contain;
}

/* Navigation */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation {
    padding: 12px 10px !important;
    margin: 0 !important;
    background: transparent !important;
}

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation > li {
    margin: 3px 0 !important;
}

/* Main navigation links */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation > li > a {
    min-height: 44px;
    padding: 10px 13px !important;
    border-radius: 10px;
    display: flex;
    align-items: center;
    color: rgba(255,255,255,0.62) !important;
    background: transparent !important;
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 500;
    transition: all 0.2s ease;
}

/* Navigation icon */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation > li > a i {
    width: 22px !important;
    margin-right: 12px !important;
    font-size: 15px !important;
    text-align: center;
    color: rgba(255,255,255,0.40) !important;
}

/* Navigation text */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation > li > a span {
    color: inherit !important;
    font-size: 13px !important;
    font-weight: 500;
}

/* Hover */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation > li > a:hover {
    background: rgba(255,255,255,0.055) !important;
    color: #ffffff !important;
    padding-left: 16px !important;
}

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation > li > a:hover i {
    color: #00c8ff !important;
}

/* Active menu */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation > li.active > a {
    background: linear-gradient(
        90deg,
        rgba(72,49,212,0.28),
        rgba(0,200,255,0.08)
    ) !important;
    color: #ffffff !important;
    border: 1px solid rgba(72,49,212,0.20);
    box-shadow: 0 5px 18px rgba(72,49,212,0.10);
}

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation > li.active > a i {
    color: #00c8ff !important;
}

/* Active indicator */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation > li.active > a:before {
    content: "";
    position: absolute;
    left: 0;
    width: 3px;
    height: 22px;
    border-radius: 0 5px 5px 0;
    background: linear-gradient(
        180deg,
        #4831d4,
        #00c8ff
    );
}

/* Sub menus */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation li ul.sub-menu {
    background: rgba(255,255,255,0.015) !important;
    border-left: 1px solid rgba(255,255,255,0.07);
    margin-left: 23px !important;
    padding: 4px 0 !important;
}

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation li ul.sub-menu li a {
    color: rgba(255,255,255,0.50) !important;
    background: transparent !important;
    font-size: 11px !important;
    padding: 7px 12px !important;
    border-radius: 6px;
}

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation li ul.sub-menu li a:hover {
    color: #ffffff !important;
    background: rgba(255,255,255,0.05) !important;
}

/* Section spacing */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation + .cl-vnavigation {
    margin-top: 4px !important;
}

/* Prevent old Bootstrap column widths inside menu */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation .col-xs-1 {
    width: 22px !important;
    padding: 0 !important;
    flex: 0 0 22px;
}

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation .col-xs-9 {
    width: auto !important;
    padding: 0 !important;
    flex: 1;
}

/* Sidebar scrollbar */
#cl-wrapper.vicidial-modern-enabled .cl-sidebar::-webkit-scrollbar {
    width: 5px;
}

#cl-wrapper.vicidial-modern-enabled .cl-sidebar::-webkit-scrollbar-track {
    background: transparent;
}

#cl-wrapper.vicidial-modern-enabled .cl-sidebar::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,0.10);
    border-radius: 10px;
}

#cl-wrapper.vicidial-modern-enabled .cl-sidebar::-webkit-scrollbar-thumb:hover {
    background: rgba(255,255,255,0.18);
}

/* Main area starts after sidebar */
#cl-wrapper.vicidial-modern-enabled #pcont {
    margin-left: 260px !important;
}

/* Mobile */
@media (max-width: 992px) {

    #cl-wrapper.vicidial-modern-enabled .cl-sidebar {
        width: 260px !important;
        transform: translateX(-100%);
    }

    #cl-wrapper.vicidial-modern-enabled .cl-sidebar.open {
        transform: translateX(0);
    }

    #cl-wrapper.vicidial-modern-enabled #pcont {
        margin-left: 0 !important;
    }
}


/* ============================================================
   Phase 1C.3 - Modern VICIdial Brand
   ============================================================ */

#cl-wrapper.vicidial-modern-enabled .modern-brand {
    height: 76px !important;
    width: 260px !important;
    padding: 0 20px !important;
    display: flex;
    align-items: center;
    background: transparent !important;
    border: 0 !important;
}

#cl-wrapper.vicidial-modern-enabled .modern-brand-link {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    text-decoration: none;
}

#cl-wrapper.vicidial-modern-enabled .modern-brand-icon {
    width: 40px;
    height: 40px;
    min-width: 40px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #4831d4, #00c8ff);
    color: #fff;
    font-size: 18px;
    box-shadow: 0 6px 20px rgba(72,49,212,0.25);
}

#cl-wrapper.vicidial-modern-enabled .modern-brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.1;
}

#cl-wrapper.vicidial-modern-enabled .modern-brand-text strong {
    color: #fff;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.3px;
}

#cl-wrapper.vicidial-modern-enabled .modern-brand-text small {
    margin-top: 4px;
    color: rgba(255,255,255,0.38);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 1.2px;
}

#cl-wrapper.vicidial-modern-enabled .modern-brand-link:hover {
    text-decoration: none;
}

#cl-wrapper.vicidial-modern-enabled .modern-brand-link:hover
.modern-brand-icon {
    box-shadow: 0 8px 25px rgba(0,200,255,0.22);
    transform: translateY(-1px);
    transition: all 0.2s ease;
}


/* ============================================================
   Phase 1C.4 - User Profile / Status / Logout
   ============================================================ */

#cl-wrapper.vicidial-modern-enabled .modern-user-panel {
    width: 260px;
    min-height: 76px;
    padding: 10px 15px;
    display: flex;
    align-items: center;
    gap: 10px;
    border-bottom: 1px solid rgba(255,255,255,0.07);
    background: rgba(255,255,255,0.015);
}

#cl-wrapper.vicidial-modern-enabled .modern-user-avatar {
    width: 38px;
    height: 38px;
    min-width: 38px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #4831d4, #00c8ff);
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    box-shadow: 0 4px 14px rgba(72,49,212,0.20);
}

#cl-wrapper.vicidial-modern-enabled .modern-user-info {
    min-width: 0;
    flex: 1;
}

#cl-wrapper.vicidial-modern-enabled .modern-user-name {
    display: block;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}

#cl-wrapper.vicidial-modern-enabled .modern-user-role {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-top: 4px;
    color: rgba(255,255,255,0.40);
    font-size: 8px;
    font-weight: 600;
    letter-spacing: 0.7px;
    text-transform: uppercase;
}

#cl-wrapper.vicidial-modern-enabled .modern-status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #35e68a;
    box-shadow: 0 0 8px rgba(53,230,138,0.65);
}

#cl-wrapper.vicidial-modern-enabled .modern-logout {
    width: 30px;
    height: 30px;
    min-width: 30px;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: transparent;
    color: rgba(255,255,255,0.45);
    text-decoration: none;
    transition: all 0.2s ease;
}

#cl-wrapper.vicidial-modern-enabled .modern-logout:hover {
    color: #ff5c6c;
    border-color: rgba(255,92,108,0.30);
    background: rgba(255,92,108,0.08);
    text-decoration: none;
}

/* Top header cleanup */
#cl-wrapper.vicidial-modern-enabled #head-nav {
    background: rgba(10,14,26,0.92) !important;
    border: 0 !important;
    border-bottom: 1px solid rgba(255,255,255,0.06) !important;
    box-shadow: none !important;
}

#cl-wrapper.vicidial-modern-enabled .header_time,
#cl-wrapper.vicidial-modern-enabled .time_header {
    color: rgba(255,255,255,0.45) !important;
    font-size: 11px;
}


/* ============================================================
   Phase 1C.5 - Navigation Sections
   ============================================================ */

#cl-wrapper.vicidial-modern-enabled .modern-nav-section {
    padding: 14px 13px 5px;
    margin: 0;
    color: rgba(255,255,255,0.28);
    font-size: 8px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 1.3px;
    text-transform: uppercase;
}

#cl-wrapper.vicidial-modern-enabled .modern-nav-section:first-child {
    padding-top: 8px;
}

#cl-wrapper.vicidial-modern-enabled .modern-nav-divider {
    height: 1px;
    margin: 8px 13px;
    background: rgba(255,255,255,0.05);
}

/* Keep old VICIdial lists visually unified */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation {
    margin-bottom: 0 !important;
}

/* Cleaner submenu indentation */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu {
    margin-top: 3px !important;
}

/* Remove old horizontal separators */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation hr {
    border: 0 !important;
    height: 1px;
    background: rgba(255,255,255,0.05);
    margin: 8px 12px !important;
}

/* Make section groups visually continuous */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li > a {
    position: relative;
}


/* ============================================================
   Phase 1C.6 - Icons / Active State / Submenu
   ============================================================ */

/* Main menu icon alignment */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li > a {
    position: relative;
    overflow: hidden;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li > a i {
    width: 22px !important;
    min-width: 22px !important;
    margin-right: 11px !important;
    font-size: 14px !important;
    text-align: center;
    transition: all .2s ease;
}

/* Active left indicator */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.active > a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 22px;
    transform: translateY(-50%);
    border-radius: 0 5px 5px 0;
    background: linear-gradient(180deg,#4831d4,#00c8ff);
}

/* Active icon */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.active > a i {
    color: #00c8ff !important;
    transform: scale(1.05);
}

/* Hover icon */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li > a:hover i {
    color: #00c8ff !important;
    transform: translateX(1px);
}

/* Parent menu arrow */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > a::after {
    content: "\f107";
    font-family: FontAwesome;
    position: absolute;
    right: 13px;
    color: rgba(255,255,255,.30);
    font-size: 11px;
    transition: transform .2s ease;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent.open > a::after,
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.active.open > a::after {
    transform: rotate(180deg);
    color: #00c8ff;
}

/* Submenu */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu {
    margin: 3px 0 5px 23px !important;
    padding: 3px 0 3px 8px !important;
    border-left: 1px solid rgba(255,255,255,.07);
    background: transparent !important;
}

/* Submenu item */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a {
    position: relative;
    display: block;
    min-height: 30px;
    padding: 7px 10px !important;
    border-radius: 6px;
    color: rgba(255,255,255,.45) !important;
    background: transparent !important;
    font-size: 11px !important;
    transition: all .18s ease;
}

/* Submenu bullet */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a::before {
    content: "";
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-right: 8px;
    vertical-align: middle;
    border-radius: 50%;
    background: rgba(255,255,255,.25);
}

/* Submenu hover */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a:hover {
    padding-left: 13px !important;
    color: #fff !important;
    background: rgba(255,255,255,.045) !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a:hover::before {
    background: #00c8ff;
}

/* Current submenu item */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li.active > a {
    color: #fff !important;
    background: rgba(72,49,212,.13) !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li.active > a::before {
    background: #00c8ff;
}

/* Section title */
#cl-wrapper.vicidial-modern-enabled
.modern-nav-section {
    user-select: none;
}

/* Badges */
#cl-wrapper.vicidial-modern-enabled .modern-nav-badge {
    float: right;
    min-width: 20px;
    padding: 2px 6px;
    border-radius: 20px;
    background: rgba(0,200,255,.12);
    color: #00c8ff;
    font-size: 9px;
    text-align: center;
}

/* Smooth submenu appearance */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu {
    transition: opacity .18s ease, transform .18s ease;
}

/* Nested submenu */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.submenus {
    margin-left: 8px !important;
    border-left-color: rgba(255,255,255,.05);
}


/* ============================================================
   Phase 1C.6 - VICIdial Actual Menu Structure
   ============================================================ */

/* Parent items - VICIdial does not use .parent class */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li:has(> ul.sub-menu) {
    position: relative;
}

/* Arrow for menu items containing submenu */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li:has(> ul.sub-menu) > a {
    padding-right: 34px !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li:has(> ul.sub-menu) > a::after {
    content: "\f107";
    font-family: FontAwesome;
    position: absolute;
    right: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255,255,255,.28);
    font-size: 11px;
    transition: transform .2s ease, color .2s ease;
}

/* Open / active parent */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.active:has(> ul.sub-menu) > a::after {
    transform: translateY(-50%) rotate(180deg);
    color: #00c8ff;
}

/* Hover arrow */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li:has(> ul.sub-menu) > a:hover::after {
    color: #00c8ff;
}

/* Active main menu */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.active > a {
    background: linear-gradient(
        90deg,
        rgba(72,49,212,.22),
        rgba(0,200,255,.06)
    ) !important;
    color: #ffffff !important;
}

/* Active main menu icon */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.active > a i {
    color: #00c8ff !important;
}

/* Active indicator */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.active > a::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 22px;
    transform: translateY(-50%);
    border-radius: 0 4px 4px 0;
    background: linear-gradient(
        180deg,
        #4831d4,
        #00c8ff
    );
}

/* Submenu visibility */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li > ul.sub-menu {
    overflow: hidden;
    transition:
        max-height .22s ease,
        opacity .18s ease;
}

/* Nested submenu */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation ul.submenus {
    margin-left: 8px !important;
}

/* Remove old VICIdial selected background attributes visually */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li[bgcolor] {
    background: transparent !important;
}


/* ============================================================
   Phase 1C.6 - VICIdial Core.js Integration
   ============================================================ */

/* Parent menu generated dynamically by core.js */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > a {
    padding-right: 34px !important;
}

/* Parent arrow */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > a::after {
    content: "\f107";
    font-family: FontAwesome;
    position: absolute;
    right: 13px;
    top: 50%;
    transform: translateY(-50%);
    color: rgba(255,255,255,.28);
    font-size: 11px;
    transition: transform .25s ease, color .2s ease;
}

/* Open parent */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent.open > a::after {
    transform: translateY(-50%) rotate(180deg);
    color: #00c8ff;
}

/* Active parent */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent.active > a {
    background: linear-gradient(
        90deg,
        rgba(72,49,212,.22),
        rgba(0,200,255,.06)
    ) !important;
    color: #ffffff !important;
}

/* Active parent icon */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent.active > a i {
    color: #00c8ff !important;
}

/* Open parent */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent.open > a {
    color: #ffffff !important;
}

/* Submenu */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > ul.sub-menu {
    margin-left: 23px !important;
    padding: 4px 0 4px 8px !important;
    border-left: 1px solid rgba(255,255,255,.07);
    background: transparent !important;
}

/* Submenu links */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > ul.sub-menu > li > a {
    min-height: 30px;
    padding: 7px 10px !important;
    border-radius: 6px;
    color: rgba(255,255,255,.45) !important;
    background: transparent !important;
    font-size: 11px !important;
    transition: all .18s ease;
}

/* Submenu bullet */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > ul.sub-menu > li > a::before {
    content: "";
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-right: 8px;
    vertical-align: middle;
    border-radius: 50%;
    background: rgba(255,255,255,.25);
}

/* Submenu hover */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > ul.sub-menu > li > a:hover {
    padding-left: 14px !important;
    color: #ffffff !important;
    background: rgba(255,255,255,.05) !important;
}

/* Active submenu */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > ul.sub-menu > li.active > a {
    color: #ffffff !important;
    background: rgba(72,49,212,.14) !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > ul.sub-menu > li.active > a::before {
    background: #00c8ff;
}

/* Nested submenu */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation ul.submenus {
    margin-left: 8px !important;
    border-left-color: rgba(255,255,255,.05);
}


/* ============================================================
   Phase 1C.6 - Submenu Readability Fix
   ============================================================ */

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a {
    color: #b8c1d1 !important;
    background: transparent !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    text-shadow: none !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a span {
    color: #b8c1d1 !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a:hover {
    color: #ffffff !important;
    background: rgba(72,49,212,0.14) !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li.active > a {
    color: #ffffff !important;
    background: rgba(72,49,212,0.20) !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a::before {
    background: #68758a;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a:hover::before,
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li.active > a::before {
    background: #00c8ff;
}


/* ============================================================
   FINAL SUBMENU TEXT OVERRIDE
   ============================================================ */

#cl-wrapper.vicidial-modern-enabled
.cl-sidebar .cl-vnavigation li ul.sub-menu li a,
#cl-wrapper.vicidial-modern-enabled
.cl-sidebar .cl-vnavigation li ul.sub-menu li a:link,
#cl-wrapper.vicidial-modern-enabled
.cl-sidebar .cl-vnavigation li ul.sub-menu li a:visited {
    color: #b8c1d1 !important;
    background-color: transparent !important;
    font-size: 12px !important;
    font-weight: 500 !important;
    text-decoration: none !important;
    text-shadow: none !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-sidebar .cl-vnavigation li ul.sub-menu li a:hover {
    color: #ffffff !important;
    background-color: rgba(72,49,212,0.18) !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-sidebar .cl-vnavigation li ul.sub-menu li a::before {
    background: #68758a !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-sidebar .cl-vnavigation li ul.sub-menu li a:hover::before {
    background: #00c8ff !important;
}


/* ============================================================
   Phase 1C.6 - Smooth Navigation
   ============================================================ */

#cl-wrapper.vicidial-modern-enabled .cl-vnavigation > li > a {
    transition:
        background-color 0.25s ease,
        color 0.25s ease,
        padding-left 0.25s ease;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li > a i {
    transition:
        color 0.25s ease,
        transform 0.25s ease;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > a::after {
    transition:
        transform 0.30s ease,
        color 0.25s ease;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a {
    transition:
        background-color 0.25s ease,
        color 0.25s ease,
        padding-left 0.25s ease;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a:hover {
    padding-left: 13px !important;
}

/* Don't create extra CSS height animation.
   VICIdial core.js controls submenu slideToggle(). */

