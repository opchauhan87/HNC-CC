/* ============================================================
   Phase 1C.14 - Admin Navigation UX
   ============================================================ */

/* Sidebar base */
#cl-wrapper.vicidial-modern-enabled .cl-sidebar {
    background: #0d1320 !important;
    border-right: 1px solid rgba(255,255,255,.06) !important;
}

/* Navigation container */
#cl-wrapper.vicidial-modern-enabled .cl-vnavigation {
    padding: 8px 8px 25px !important;
}

/* Section / menu headings */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation .head_title {
    margin: 18px 8px 7px !important;
    padding: 0 8px !important;

    color: #59677b !important;
    background: transparent !important;

    font-size: 9px !important;
    font-weight: 700 !important;
    line-height: 20px !important;

    letter-spacing: 1px !important;
    text-transform: uppercase !important;
}

/* Main menu items */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li {
    margin: 2px 0 !important;
}

/* Main menu links */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li > a {
    position: relative;

    min-height: 40px !important;
    padding: 10px 12px !important;

    display: flex !important;
    align-items: center !important;

    color: #8d9aad !important;
    background: transparent !important;

    border-radius: 8px !important;

    font-size: 11px !important;
    font-weight: 500 !important;

    text-decoration: none !important;

    transition:
        color .18s ease,
        background-color .18s ease,
        transform .18s ease;
}

/* Icons */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li > a i {
    width: 22px !important;
    margin-right: 9px !important;

    color: #637187 !important;

    font-size: 14px !important;
    text-align: center !important;

    transition: color .18s ease;
}

/* Hover */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li > a:hover {
    color: #e4ebf4 !important;
    background: rgba(255,255,255,.045) !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li > a:hover i {
    color: #00c8ff !important;
}

/* Active item */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.active > a,
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.selected > a {
    color: #ffffff !important;
    background:
        linear-gradient(
            90deg,
            rgba(72,49,212,.22),
            rgba(72,49,212,.07)
        ) !important;
}

/* Active indicator */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.active > a::before,
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.selected > a::before {
    content: "";
    position: absolute;

    left: 0;
    top: 8px;
    bottom: 8px;

    width: 3px;

    border-radius: 0 4px 4px 0;

    background: #00c8ff;
}

/* Active icon */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.active > a i,
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.selected > a i {
    color: #00c8ff !important;
}


/* ------------------------------------------------------------
   Parent menu
   ------------------------------------------------------------ */

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > a {
    padding-right: 32px !important;
}

/* Parent arrow */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent > a::after {
    position: absolute;

    right: 12px;

    color: #566478;

    font-family: FontAwesome;
    font-size: 10px;

    content: "\f105";

    transition: transform .2s ease, color .2s ease;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation > li.parent.open > a::after {
    color: #00c8ff;
    transform: rotate(90deg);
}


/* ------------------------------------------------------------
   Submenu
   ------------------------------------------------------------ */

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu {
    margin: 2px 0 5px 0 !important;
    padding: 3px 0 3px 17px !important;

    background: transparent !important;
    border-left: 1px solid rgba(255,255,255,.055) !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li {
    margin: 1px 0 !important;
}

/* Submenu link */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a {
    position: relative;

    display: flex !important;
    align-items: center !important;

    min-height: 32px !important;

    padding: 7px 9px !important;

    color: #77869a !important;
    background: transparent !important;

    border-radius: 6px !important;

    font-size: 10px !important;
    font-weight: 500 !important;

    text-decoration: none !important;

    transition:
        color .18s ease,
        background-color .18s ease,
        padding-left .18s ease;
}

/* Submenu hover */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li a:hover {
    padding-left: 12px !important;

    color: #dce5ef !important;
    background: rgba(0,200,255,.045) !important;
}

/* Submenu active */
#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li.active > a {
    color: #ffffff !important;
    background: rgba(72,49,212,.13) !important;
}

#cl-wrapper.vicidial-modern-enabled
.cl-vnavigation li ul.sub-menu li.active > a::before {
    content: "";

    position: absolute;
    left: -18px;

    width: 3px;
    height: 18px;

    border-radius: 0 3px 3px 0;

    background: #00c8ff;
}


/* ------------------------------------------------------------
   Sidebar scrollbar
   ------------------------------------------------------------ */

#cl-wrapper.vicidial-modern-enabled
.cl-sidebar .nscroller::-webkit-scrollbar {
    width: 5px;
}

#cl-wrapper.vicidial-modern-enabled
.cl-sidebar .nscroller::-webkit-scrollbar-track {
    background: transparent;
}

#cl-wrapper.vicidial-modern-enabled
.cl-sidebar .nscroller::-webkit-scrollbar-thumb {
    background: rgba(255,255,255,.08);
    border-radius: 10px;
}

#cl-wrapper.vicidial-modern-enabled
.cl-sidebar .nscroller::-webkit-scrollbar-thumb:hover {
    background: rgba(0,200,255,.22);
}


/* ------------------------------------------------------------
   Collapsed desktop sidebar
   ------------------------------------------------------------ */

@media (min-width: 993px) {

    #cl-wrapper.vicidial-modern-enabled.sb-collapsed
    .cl-vnavigation {
        padding-left: 6px !important;
        padding-right: 6px !important;
    }

    #cl-wrapper.vicidial-modern-enabled.sb-collapsed
    .cl-vnavigation > li > a {
        justify-content: center !important;
        padding: 10px 0 !important;
    }

    #cl-wrapper.vicidial-modern-enabled.sb-collapsed
    .cl-vnavigation > li > a i {
        width: 100% !important;
        margin: 0 !important;
    }

    #cl-wrapper.vicidial-modern-enabled.sb-collapsed
    .cl-vnavigation > li > a span {
        display: none !important;
    }

    #cl-wrapper.vicidial-modern-enabled.sb-collapsed
    .cl-vnavigation > li.parent > a::after {
        display: none !important;
    }

    #cl-wrapper.vicidial-modern-enabled.sb-collapsed
    .cl-vnavigation .head_title {
        display: none !important;
    }
}


/* ============================================================
   Phase 1C.15 - Top Header / Command Bar
   ============================================================ */

/* Main sticky header */
#cl-wrapper.vicidial-modern-enabled
> .col-md-12:first-of-type {
    background: #0b111d !important;
    border-bottom: 1px solid rgba(255,255,255,.06) !important;
    box-shadow: 0 4px 18px rgba(0,0,0,.18) !important;
}

/* Header row */
#cl-wrapper.vicidial-modern-enabled
#head-nav {
    min-height: 64px !important;

    background: #0b111d !important;
    border: 0 !important;

    box-shadow: none !important;
}

/* Header container */
#cl-wrapper.vicidial-modern-enabled
#head-nav .container-fluid {
    min-height: 64px !important;
}

/* ------------------------------------------------------------
   Modern brand
   ------------------------------------------------------------ */

#cl-wrapper.vicidial-modern-enabled
.modern-brand {
    height: 64px !important;

    display: flex !important;
    align-items: center !important;

    padding: 0 12px !important;

    background: #0b111d !important;
}

#cl-wrapper.vicidial-modern-enabled
.modern-brand-link {
    display: flex !important;
    align-items: center !important;

    gap: 10px;

    color: #ffffff !important;

    text-decoration: none !important;
}

#cl-wrapper.vicidial-modern-enabled
.modern-brand-icon {
    width: 36px;
    height: 36px;

    display: flex;
    align-items: center;
    justify-content: center;

    border-radius: 10px;

    color: #00c8ff;

    background:
        linear-gradient(
            135deg,
            rgba(72,49,212,.25),
            rgba(0,200,255,.10)
        );

    border: 1px solid rgba(0,200,255,.10);

    box-shadow: 0 5px 18px rgba(0,0,0,.18);
}

#cl-wrapper.vicidial-modern-enabled
.modern-brand-icon i {
    font-size: 16px;
}

#cl-wrapper.vicidial-modern-enabled
.modern-brand-text {
    display: flex;
    flex-direction: column;

    line-height: 1.1;
}

#cl-wrapper.vicidial-modern-enabled
.modern-brand-text strong {
    color: #f1f5f9;

    font-size: 14px;
    font-weight: 700;

    letter-spacing: .2px;
}

#cl-wrapper.vicidial-modern-enabled
.modern-brand-text small {
    margin-top: 4px;

    color: #58677b;

    font-size: 7px;
    font-weight: 700;

    letter-spacing: 1px;
}


/* ------------------------------------------------------------
   Header right side
   ------------------------------------------------------------ */

#cl-wrapper.vicidial-modern-enabled
#head-nav .navbar-collapse {
    min-height: 64px !important;

    display: flex !important;
    align-items: center !important;
    justify-content: flex-end !important;
}


/* Username */
#cl-wrapper.vicidial-modern-enabled
#head-nav .profile_menu > span {
    display: inline-flex !important;
    align-items: center !important;

    margin-top: 0 !important;
    margin-right: 8px !important;

    color: #cbd5e1 !important;

    font-size: 11px !important;
    font-weight: 600 !important;
}


/* Profile menu */
#cl-wrapper.vicidial-modern-enabled
#head-nav .profile_menu {
    display: flex !important;
    align-items: center !important;

    margin-right: 8px;
}

#cl-wrapper.vicidial-modern-enabled
#head-nav .profile_menu > a {
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    width: 34px;
    height: 34px;

    border-radius: 8px;

    background: rgba(255,255,255,.035) !important;
    border: 1px solid rgba(255,255,255,.06);

    transition: all .18s ease;
}

#cl-wrapper.vicidial-modern-enabled
#head-nav .profile_menu > a:hover {
    background: rgba(0,200,255,.07) !important;
    border-color: rgba(0,200,255,.16);
}


/* Hide old avatar */
#cl-wrapper.vicidial-modern-enabled
#head-nav .profile_menu > img {
    display: none !important;
}


/* Menu icon */
#cl-wrapper.vicidial-modern-enabled
#head-nav .profile_menu img.nav_menu {
    width: 15px !important;
    height: 15px !important;

    opacity: .65;

    transition: opacity .18s ease;
}

#cl-wrapper.vicidial-modern-enabled
#head-nav .profile_menu > a:hover img.nav_menu {
    opacity: 1;
}


/* ------------------------------------------------------------
   Profile dropdown
   ------------------------------------------------------------ */

#cl-wrapper.vicidial-modern-enabled
#head-nav .profile_menu .dropdown-menu {
    min-width: 190px !important;

    margin-top: 9px !important;
    padding: 6px !important;

    background: #111a29 !important;

    border: 1px solid rgba(255,255,255,.07) !important;
    border-radius: 10px !important;

    box-shadow: 0 18px 45px rgba(0,0,0,.38) !important;
}

#cl-wrapper.vicidial-modern-enabled
#head-nav .profile_menu .dropdown-menu li a {
    display: block;

    padding: 9px 11px !important;

    color: #8f9caf !important;

    border-radius: 7px;

    font-size: 10px !important;

    transition:
        color .18s ease,
        background-color .18s ease;
}

#cl-wrapper.vicidial-modern-enabled
#head-nav .profile_menu .dropdown-menu li a:hover {
    color: #ffffff !important;
    background: rgba(0,200,255,.06) !important;
}


/* ------------------------------------------------------------
   Header time
   ------------------------------------------------------------ */

#cl-wrapper.vicidial-modern-enabled
.header_time {
    width: auto !important;

    display: flex !important;
    align-items: center !important;

    margin-right: 8px !important;
}

#cl-wrapper.vicidial-modern-enabled
.time_header {
    color: #69778a !important;

    font-size: 9px !important;
    font-weight: 500 !important;

    white-space: nowrap;

    letter-spacing: .2px;
}


/* ------------------------------------------------------------
   Call Information
   ------------------------------------------------------------ */

#cl-wrapper.vicidial-modern-enabled
.notifications-menu > a {
    width: 36px;
    height: 36px;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    margin-left: 7px;

    border-radius: 9px;

    background: rgba(255,255,255,.035) !important;
    border: 1px solid rgba(255,255,255,.06);

    transition: all .18s ease;
}

#cl-wrapper.vicidial-modern-enabled
.notifications-menu > a:hover {
    background: rgba(0,200,255,.07) !important;
    border-color: rgba(0,200,255,.16);
}

#cl-wrapper.vicidial-modern-enabled
.notifications-menu > a i {
    color: #00c8ff !important;
    font-size: 15px !important;
}


/* Version dropdown */
#cl-wrapper.vicidial-modern-enabled
.notifications-menu .dropdown-menu {
    min-width: 220px;

    background: #111a29 !important;

    border: 1px solid rgba(255,255,255,.07) !important;
    border-radius: 10px !important;

    box-shadow: 0 18px 45px rgba(0,0,0,.4) !important;
}

#cl-wrapper.vicidial-modern-enabled
.notifications-menu .dropdown-menu p {
    margin: 0 !important;
    padding: 10px !important;

    color: #8491a4 !important;

    line-height: 1.8 !important;
}

#cl-wrapper.vicidial-modern-enabled
.notifications-menu .dropdown-menu strong {
    color: #dbe4ef !important;
}


/* ------------------------------------------------------------
   Logout
   ------------------------------------------------------------ */

#cl-wrapper.vicidial-modern-enabled
#head-nav .spacer {
    padding-left: 8px !important;
}

#cl-wrapper.vicidial-modern-enabled
#head-nav .spacer a {
    width: 36px;
    height: 36px;

    display: flex !important;
    align-items: center;
    justify-content: center;

    border-radius: 9px;

    background: rgba(255,255,255,.035);

    border: 1px solid rgba(255,255,255,.06);

    transition: all .18s ease;
}

#cl-wrapper.vicidial-modern-enabled
#head-nav .spacer a:hover {
    background: rgba(255,70,90,.08);
    border-color: rgba(255,70,90,.18);
}

#cl-wrapper.vicidial-modern-enabled
#head-nav .spacer a i {
    color: #8491a4 !important;
    font-size: 15px !important;
}

#cl-wrapper.vicidial-modern-enabled
#head-nav .spacer a:hover i {
    color: #ff6b7a !important;
}


/* ------------------------------------------------------------
   Mobile header
   ------------------------------------------------------------ */

@media (max-width: 767px) {

    #cl-wrapper.vicidial-modern-enabled
    .modern-brand {
        width: 100% !important;
        height: 54px !important;

        padding-left: 60px !important;
    }

    #cl-wrapper.vicidial-modern-enabled
    #head-nav {
        min-height: 54px !important;
    }

    #cl-wrapper.vicidial-modern-enabled
    #head-nav .container-fluid {
        min-height: 54px !important;
    }

    #cl-wrapper.vicidial-modern-enabled
    .time_header {
        display: none !important;
    }

    #cl-wrapper.vicidial-modern-enabled
    #head-nav .profile_menu > span {
        display: none !important;
    }

    #cl-wrapper.vicidial-modern-enabled
    .notifications-menu {
        display: none !important;
    }

    #cl-wrapper.vicidial-modern-enabled
    .modern-brand-text small {
        display: none;
    }
}


/* ------------------------------------------------------------
   Tablet
   ------------------------------------------------------------ */

@media (min-width: 768px) and (max-width: 992px) {

    #cl-wrapper.vicidial-modern-enabled
    .modern-brand {
        padding-left: 60px !important;
    }

    #cl-wrapper.vicidial-modern-enabled
    .time_header {
        display: none !important;
    }
}


/* ============================================================
   Phase 1C.17 - Admin Dashboard / Reports UX
   ============================================================ */

/* Dashboard page */
#cl-wrapper.vicidial-modern-enabled
#pcont4.server-state {
    padding-top: 12px !important;
}

#cl-wrapper.vicidial-modern-enabled
.server-state > .row {
    margin-left: 0 !important;
    margin-right: 0 !important;
}

/* Main dashboard card */
#cl-wrapper.vicidial-modern-enabled
.server-state .block-flat {
    background: #101827 !important;
    border: 1px solid rgba(255,255,255,.055) !important;
    border-radius: 12px !important;

    box-shadow:
        0 10px 30px rgba(0,0,0,.18),
        0 1px 0 rgba(255,255,255,.02) inset !important;

    overflow: hidden;
}

/* Dashboard title */
#cl-wrapper.vicidial-modern-enabled
.server-state .block-flat > .header {
    min-height: 54px !important;

    display: flex !important;
    align-items: center !important;

    padding: 0 18px !important;

    background:
        linear-gradient(
            90deg,
            rgba(72,49,212,.10),
            transparent
        ) !important;

    border-bottom: 1px solid rgba(255,255,255,.055) !important;
}

#cl-wrapper.vicidial-modern-enabled
.server-state .block-flat > .header h3 {
    margin: 0 !important;

    color: #e8eef6 !important;

    font-size: 14px !important;
    font-weight: 600 !important;

    letter-spacing: .15px !important;
}

/* Content area */
#cl-wrapper.vicidial-modern-enabled
.server-state .block-flat > .content {
    background: transparent !important;
}

/* Report section */
#cl-wrapper.vicidial-modern-enabled
.server-state .table-striped {
    margin-bottom: 14px !important;

    padding: 0 !important;

    background: #0d1522 !important;

    border: 1px solid rgba(255,255,255,.045) !important;
    border-radius: 9px !important;

    overflow: hidden;
}

/* Section header */
#cl-wrapper.vicidial-modern-enabled
.server-state .report_head,
#cl-wrapper.vicidial-modern-enabled
.server-state .well-white-header {
    width: 100% !important;

    min-height: 38px !important;

    display: flex !important;
    align-items: center !important;

    padding: 0 13px !important;

    color: #dce5ef !important;
    background:
        linear-gradient(
            90deg,
            rgba(0,200,255,.055),
            rgba(72,49,212,.035)
        ) !important;

    border-bottom: 1px solid rgba(255,255,255,.045) !important;

    font-size: 10px !important;
    font-weight: 700 !important;

    letter-spacing: .45px !important;
    text-transform: uppercase !important;
}

/* Report links */
#cl-wrapper.vicidial-modern-enabled
.server-state .table-striped > .col-md-6 {
    min-height: 36px !important;

    padding: 0 !important;

    border-bottom: 1px solid rgba(255,255,255,.025);
}

/* Last row cleanup */
#cl-wrapper.vicidial-modern-enabled
.server-state .table-striped > .col-md-6:last-child {
    border-bottom: 0 !important;
}

#cl-wrapper.vicidial-modern-enabled
.server-state .table-striped > .col-md-6 > a {
    min-height: 36px !important;

    display: flex !important;
    align-items: center !important;

    padding: 7px 12px !important;

    color: #8290a3 !important;

    font-size: 10px !important;
    font-weight: 500 !important;

    text-decoration: none !important;

    transition:
        color .16s ease,
        background-color .16s ease,
        padding-left .16s ease;
}

/* Link arrow */
#cl-wrapper.vicidial-modern-enabled
.server-state .table-striped > .col-md-6 > a::before {
    content: "\f105";

    margin-right: 8px;

    color: #4d5b6d;

    font-family: FontAwesome;
    font-size: 9px;

    transition: color .16s ease;
}

/* Hover */
#cl-wrapper.vicidial-modern-enabled
.server-state .table-striped > .col-md-6 > a:hover {
    padding-left: 16px !important;

    color: #ffffff !important;
    background: rgba(0,200,255,.035) !important;
}

#cl-wrapper.vicidial-modern-enabled
.server-state .table-striped > .col-md-6 > a:hover::before {
    color: #00c8ff;
}

/* Secondary links like v2 / Export / Detail */
#cl-wrapper.vicidial-modern-enabled
.server-state .table-striped > .col-md-6 {
    color: #6e7c90 !important;
}

#cl-wrapper.vicidial-modern-enabled
.server-state .table-striped > .col-md-6 > a + a {
    display: inline-flex !important;

    min-height: 0 !important;

    padding: 0 4px !important;

    color: #596a7e !important;

    background: transparent !important;
}

#cl-wrapper.vicidial-modern-enabled
.server-state .table-striped > .col-md-6 > a + a::before {
    display: none !important;
}

#cl-wrapper.vicidial-modern-enabled
.server-state .table-striped > .col-md-6 > a + a:hover {
    padding-left: 4px !important;

    color: #00c8ff !important;
}


/* ------------------------------------------------------------
   Server summary table
   ------------------------------------------------------------ */

#cl-wrapper.vicidial-modern-enabled
.server-state pre {
    margin: 0 !important;

    padding: 0 !important;

    background: transparent !important;

    border: 0 !important;
}

#cl-wrapper.vicidial-modern-enabled
.server-state pre table {
    width: 100% !important;

    background: #0d1522 !important;

    border: 1px solid rgba(255,255,255,.055) !important;
    border-radius: 9px !important;

    overflow: hidden;
}

#cl-wrapper.vicidial-modern-enabled
.server-state pre table td {
    padding: 8px 10px !important;

    color: #8795a8 !important;

    background: transparent !important;

    border-color: rgba(255,255,255,.045) !important;

    font-size: 10px !important;
}

#cl-wrapper.vicidial-modern-enabled
.server-state pre table tr:first-child td {
    color: #dce5ef !important;

    background: rgba(255,255,255,.025) !important;

    font-weight: 600 !important;
}


/* ------------------------------------------------------------
   Dashboard responsive
   ------------------------------------------------------------ */

@media (max-width: 767px) {

    #cl-wrapper.vicidial-modern-enabled
    .server-state {
        padding: 8px !important;
    }

    #cl-wrapper.vicidial-modern-enabled
    .server-state .block-flat {
        border-radius: 9px !important;
    }

    #cl-wrapper.vicidial-modern-enabled
    .server-state .table-striped > .col-md-6 {
        width: 100% !important;
    }

    #cl-wrapper.vicidial-modern-enabled
    .server-state pre {
        overflow-x: auto !important;
    }

    #cl-wrapper.vicidial-modern-enabled
    .server-state pre table {
        min-width: 720px !important;
    }
}


/* ============================================================
   Phase 1C.19 - Admin Utilities Modern Grid
   ============================================================ */

#cl-wrapper.vicidial-modern-enabled .Admin-utilities {
    background: #0b1320 !important;
    border: 1px solid rgba(255,255,255,.045) !important;
    border-radius: 12px !important;
    box-shadow: 0 12px 35px rgba(0,0,0,.22) !important;
    overflow: hidden;
}

#cl-wrapper.vicidial-modern-enabled .Admin-utilities > .header {
    background:
        linear-gradient(
            90deg,
            rgba(72,49,212,.10),
            rgba(0,200,255,.055)
        ) !important;
    border-bottom: 1px solid rgba(255,255,255,.05) !important;
    padding: 16px 20px !important;
}

#cl-wrapper.vicidial-modern-enabled .Admin-utilities > .header h3 {
    color: #dce5ef !important;
    font-size: 14px !important;
    font-weight: 700 !important;
    letter-spacing: .35px !important;
    margin: 0 !important;
}

#cl-wrapper.vicidial-modern-enabled .Admin-well-white {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px !important;

    margin: 0 !important;
    padding: 18px !important;

    background: transparent !important;
    border: 0 !important;
    box-shadow: none !important;

    list-style: none !important;
}

/* Individual utility card */
#cl-wrapper.vicidial-modern-enabled .Admin-well-white > li {
    float: none !important;
    width: auto !important;
    min-height: 48px;

    margin: 0 !important;
    padding: 0 !important;

    display: flex !important;
    align-items: stretch !important;

    background: #101a29 !important;
    border: 1px solid rgba(255,255,255,.045) !important;
    border-radius: 9px !important;

    transition:
        transform .18s ease,
        border-color .18s ease,
        background .18s ease,
        box-shadow .18s ease !important;
}

/* Main link */
#cl-wrapper.vicidial-modern-enabled .Admin-well-white > li > a {
    flex: 1 !important;

    display: flex !important;
    align-items: center !important;

    min-height: 48px;

    padding: 10px 13px !important;

    color: #b9c6d8 !important;
    background: transparent !important;

    border: 0 !important;
    border-radius: 9px !important;

    font-size: 12px !important;
    font-weight: 600 !important;
    line-height: 1.35 !important;

    text-decoration: none !important;
}

/* Small utility indicator */
#cl-wrapper.vicidial-modern-enabled .Admin-well-white > li > a::before {
    content: "›";

    width: 22px;
    height: 22px;

    margin-right: 9px;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    flex: 0 0 22px;

    color: #00c8ff;

    background: rgba(0,200,255,.08);
    border: 1px solid rgba(0,200,255,.10);
    border-radius: 6px;

    font-size: 14px;
    font-weight: 700;

    transition: all .18s ease;
}

/* Hover */
#cl-wrapper.vicidial-modern-enabled .Admin-well-white > li:hover {
    background: #142135 !important;

    border-color: rgba(0,200,255,.20) !important;

    transform: translateY(-2px);

    box-shadow:
        0 8px 22px rgba(0,0,0,.22),
        0 0 18px rgba(0,200,255,.035) !important;
}

#cl-wrapper.vicidial-modern-enabled .Admin-well-white > li:hover > a {
    color: #ffffff !important;
}

#cl-wrapper.vicidial-modern-enabled .Admin-well-white > li:hover > a::before {
    color: #ffffff;
    background: rgba(0,200,255,.16);
    border-color: rgba(0,200,255,.25);
    transform: translateX(2px);
}

/* Multiple links inside same utility item */
#cl-wrapper.vicidial-modern-enabled .Admin-well-white > li > a + a {
    flex: 0 0 auto !important;

    display: inline-flex !important;
    align-items: center !important;

    min-height: 48px;

    padding: 10px 10px !important;

    color: #7f91a8 !important;

    font-size: 11px !important;
    font-weight: 600 !important;

    border-left: 1px solid rgba(255,255,255,.045) !important;
    border-radius: 0 !important;
}

#cl-wrapper.vicidial-modern-enabled .Admin-well-white > li > a + a::before {
    display: none !important;
}

#cl-wrapper.vicidial-modern-enabled .Admin-well-white > li > a + a:hover {
    color: #00c8ff !important;
    background: rgba(0,200,255,.045) !important;
}

/* Remove old list styling */
#cl-wrapper.vicidial-modern-enabled .Admin-well-white li {
    list-style: none !important;
}

/* Responsive */
@media (max-width: 1100px) {
    #cl-wrapper.vicidial-modern-enabled .Admin-well-white {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }
}

@media (max-width: 700px) {
    #cl-wrapper.vicidial-modern-enabled .Admin-well-white {
        grid-template-columns: 1fr;
        padding: 12px !important;
    }

    #cl-wrapper.vicidial-modern-enabled .Admin-utilities > .header {
        padding: 13px 15px !important;
    }

    #cl-wrapper.vicidial-modern-enabled .Admin-utilities > .header h3 {
        font-size: 12px !important;
    }
}

